{
  "name": "us-business-cycles-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static interactive companion to the us-business-cycles-v1 publication artifact.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "npm run verify:artifact && npm run build && node scripts/package-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
